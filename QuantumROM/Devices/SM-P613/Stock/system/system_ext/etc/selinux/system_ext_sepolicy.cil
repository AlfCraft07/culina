(allow apexserver dmabuf_system_heap_device (chr_file (ioctl read getattr lock map open watch watch_reads)))
;;* lme
;;* lmx 6 device/samsung/system_ext/common/sepolicy/public/apexserver.te
(allowx apexserver dmabuf_system_heap_device (ioctl chr_file (0x4800)))
;;* lme
;;* lmx 2 device/samsung/system_ext/common/sepolicy/public/domain.te
(allow domain debug_level_prop (file (read getattr map open)))
