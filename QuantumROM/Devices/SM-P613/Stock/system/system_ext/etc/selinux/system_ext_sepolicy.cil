(allow hal_dsms_server hal_dsms_service (service_manager (add find)))
;;* lme
;;* lmx 7 device/samsung/system_ext/common/sepolicy/public/hal_dsms_default.te
(neverallow base_typeattr_1085 hal_dsms_service (service_manager (add)))
;;* lme
;;* lmx 8 device/samsung/system_ext/common/sepolicy/public/hal_dsms_default.te
(allow hal_dsms_default dsms_service (service_manager (find)))
;;* lme
;;* lmx 11 device/samsung/system_ext/common/sepolicy/public/hal_dsms_default.te
(allow hal_dsms_default system_server (binder (call transfer)))
;;* lme
;;* lmx 11 device/samsung/system_ext/common/sepolicy/public/hal_dsms_default.te
(allow system_server hal_dsms_default (binder (transfer)))
;;* lme
;;* lmx 11 device/samsung/system_ext/common/sepolicy/public/hal_dsms_default.te
(allow hal_dsms_default system_server (fd (use)))
;;* lme
;;* lmx 275 device/samsung/system_ext/common/sepolicy/public/property.te
(neverallow base_typeattr_232 ctl_ker_prop (file (ioctl read write create setattr lock relabelfrom append unlink link rename open watch watch_mount watch_sb watch_with_perm watch_reads)))
;;* lme
;;* lmx 276 device/samsung/system_ext/common/sepolicy/public/property.te
(neverallow base_typeattr_232 ker_prop (file (ioctl read write create setattr lock relabelfrom append unlink link rename open watch watch_mount watch_sb watch_with_perm watch_reads)))
